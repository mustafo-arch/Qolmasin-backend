NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# Required before enabling database-backed modules
DATABASE_URL=postgresql://qolmasin:replace-with-local-password@localhost:5432/qolmasin?schema=public

# Generate separate random values (at least 32 bytes) for auth
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-secret
IP_HASH_SECRET=replace-with-a-different-32-byte-secret
EMAIL_TOKEN_SECRET=replace-with-a-different-32-byte-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=qolmasin_refresh
GLOBAL_RATE_LIMIT=100
GLOBAL_RATE_LIMIT_TTL_MS=60000
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="Qolmasin <your-account@gmail.com>"

# Required only when running `npm run prisma:seed`.
# The seed creates or idempotently updates one ADMIN account and no demo data.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=+998901234567
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_NAME=Qolmasin Admin

POSTGRES_DB=qolmasin
POSTGRES_USER=qolmasin
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432

STORAGE_DRIVER=local
API_PUBLIC_URL=http://localhost:3000
UPLOAD_LOCAL_DIR=.local-uploads
UPLOAD_MAX_BYTES=5242880
PRODUCT_IMAGE_LIMIT=5
LOW_STOCK_THRESHOLD=3
RESERVATION_TTL_MINUTES=15
ORDER_EXPIRY_INTERVAL_SECONDS=60
PICKUP_MAX_ATTEMPTS=5
NEARBY_MAX_RADIUS_KM=50
PRICE_INCREASE_ALERT_PERCENT=40
PICKUP_CODE_SECRET=replace-with-a-different-32-byte-secret
